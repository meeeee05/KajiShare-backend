# Docker image in Amazon ECR. Replace both the account ID and image tag.
IMAGE_URI=123456789012.dkr.ecr.ap-northeast-1.amazonaws.com/kajishare-backend:IMAGE_TAG

# Public hostnames. Do not include a path or trailing slash.
API_DOMAIN=api.example.com
CORS_ORIGINS=https://example.com,https://www.example.com

# Rails secrets. Never commit the real values.
RAILS_MASTER_KEY=replace_with_config_master_key
GOOGLE_CLIENT_ID=replace_with_google_client_id
FRONTEND_API_SECRET=replace_with_a_long_random_value

# RDS PostgreSQL. URL-encode reserved characters in the password.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@RDS_ENDPOINT:5432/kajishare_production

# Small-instance defaults.
RAILS_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=3
SOLID_QUEUE_IN_PUMA=true
JOB_CONCURRENCY=1
JOB_THREADS=1
